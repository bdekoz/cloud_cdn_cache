    {
      "acceptance": "No AWS UAE region/AZ assigned to Dubai; city views excluded from facility totals, with original source dates and a licensed gazetteer crosswalk.",
      "action": "Add separate city-reference views for the four public OCI regions and five explicit Gulf CloudFront cities; keep country-only Bahrain and AWS core-region geography at country precision.",
      "priority": "P0"
    },
    {
      "acceptance": "Provider, service and realm namespace every identity. No inferred Saudi code, AZ count or operational lifecycle. Existing IDs persist.",
      "action": "Refresh core directory identities and track AWS Saudi as planned for December 2026; wait for official region/AZ identifiers and launch evidence.",
      "priority": "P0"
    },

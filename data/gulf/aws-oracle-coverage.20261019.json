      "priority": "P1"
    },
    {
      "acceptance": "Dedicated realms remain separate from OC1 public regions; no public availability or tenancy-independent AD names inferred from SDK registration.",
      "action": "Add Oracle EPM's six dedicated Gulf region references in OC9, OC21, OC29 and OC36 as product-scoped evidence; review SDK-only entries separately.",
      "priority": "P1"
    },
    {
      "acceptance": "Prefix registration, routing, latency, DNS and CDN edge location remain distinct from application origins, owned facilities and service health.",
      "action": "Join official AWS/OCI prefix feeds and published geofeeds by provider/service/region; use public measurements only as dated corroboration.",
      "priority": "P2"
    },
